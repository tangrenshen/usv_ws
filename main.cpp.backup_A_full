usv_perception::LidarExtrinsic toUsvExtrinsic(const LidarExtrinsic & e)
{
  usv_perception::LidarExtrinsic u;
  u.name  = e.name;
  u.x     = e.x;
  u.y     = e.y;
  u.z     = e.z;
  u.roll  = e.roll;
  u.pitch = e.pitch;
  u.yaw   = e.yaw;
  return u;
}

LidarExtrinsic fromUsvExtrinsic(const usv_perception::LidarExtrinsic & u)
{
  LidarExtrinsic e;
  e.name  = u.name;
  e.x     = u.x;
  e.y     = u.y;
  e.z     = u.z;
  e.roll  = u.roll;
  e.pitch = u.pitch;
  e.yaw   = u.yaw;
  return e;
}

std::vector<usv_perception::LidarExtrinsic> toUsvExtrinsics(
  const std::vector<LidarExtrinsic> & v)
{
  std::vector<usv_perception::LidarExtrinsic> out;
  out.reserve(v.size());
  for (const auto & e : v) out.push_back(toUsvExtrinsic(e));
  return out;
}

std::vector<LidarExtrinsic> fromUsvExtrinsics(
  const std::vector<usv_perception::LidarExtrinsic> & v)
{
  std::vector<LidarExtrinsic> out;
  out.reserve(v.size());
  for (const auto & u : v) out.push_back(fromUsvExtrinsic(u));
  return out;
}

FisheyeIntrinsic makeFisheyeIntrinsicPlaceholder(int w, int h, double hfov_deg)
{
  FisheyeIntrinsic intr;
  intr.img_w = w;
  intr.img_h = h;
  intr.hfov_deg = hfov_deg;
  intr.lens_c2  = 4.0;
  intr.lens_c3  = 0.0;
  intr.K = cv::Mat::eye(3, 3, CV_64F);
  intr.D = cv::Mat::zeros(1, 4, CV_64F);
  return intr;
}

